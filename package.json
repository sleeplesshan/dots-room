{
  "name": "dots-room",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "bridge"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build -w bridge",
    "test": "vitest run tests/*.test.ts",
    "start": "node bridge/dist/cli.js",
    "assets:prepare": "python3 tools/assets/prepare.py",
    "assets:check": "python3 tools/assets/character-pack.py check assets/characters/bami",
    "public:check": "python3 tools/public-audit.py",
    "docs:check": "python3 tools/verify-docs.py",
    "assets:test": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "type": "module"
}
